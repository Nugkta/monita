{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "typeRoots": ["./runtime/node_modules/@types"],
    "types": ["node"],
    "baseUrl": ".",
    "paths": { "immer": ["runtime/node_modules/immer"] }
  },
  "include": ["source/src/providers/**/*.ts", "source/src/shared/types.ts", "tests/**/*.ts", "source/tests/projection.test.ts", "source/tests/adapter.test.ts", "source/tests/helpers.ts"]
}
